# ============================================================
#  .env.example — Plantilla de variables de entorno
#  Copia este archivo como .env y configura los valores reales.
#  NUNCA subas el archivo .env a control de versiones.
# ============================================================

# Django Secret Key (usada para la firma criptográfica de Django)
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplaza-con-una-clave-secreta-segura

# JWT Secret Key (usada para firmar tokens SimpleJWT)
# Puede ser igual a SECRET_KEY o una clave independiente
JWT_SECRET_KEY=reemplaza-con-una-clave-jwt-segura
